{
  "schema": { "id": "vsm.behavior.taxonomy", "version": 1 },

  "taxonomy": {
    "system": "NEUROGES",
    "systemVersion": "7cat-lausberg-peterlang",
    "source": "Hedda Lausberg, The NEUROGES® Analysis System for Nonverbal Behavior and Gesture (Peter Lang). Value sets, horizontal orders and interrater reliabilities taken from the coding manual, book II, chapters 3-16.",
    "reliabilityMeasure": "EasyDIAg interrater reliability, M±SD, from Lausberg & Slöetjes (2016)",
    "note": "Value names, their order, and the axis semantics are NEUROGES-authoritative and must not be edited without a systemVersion bump. Everything under a `vsm` key is VSM-side derived data and carries no NEUROGES authority."
  },

  "bodyParts": ["upper-limbs", "lower-limbs", "head", "trunk"],

  "categories": [
    {
      "name": "activation",
      "module": "I",
      "step": 1,
      "definition": "Segments the stream of kinesic behavior into movement and rest/pose units.",
      "values": ["movement", "rest/pose"],
      "polar": false,
      "reliability": { "movement": null, "rest/pose": null },
      "reliabilityNote": "see manual Tab. 2 (not transcribed)"
    },
    {
      "name": "structure",
      "module": "I",
      "step": 2,
      "definition": "Classifies movement units by trajectory, i.e. absence/presence and complexity of phases.",
      "values": ["irregular", "repetitive", "phasic", "shift", "aborted"],
      "restPoseValues": ["r/p rest", "r/p pose"],
      "polar": true,
      "axis": "irregular -> repetitive -> phasic: increasing complexity, from motor arousal to formative motor processes. `shift` registers transitions between still positions; `aborted` (axis end) registers abortion of movement.",
      "reliability": {
        "irregular": "0.84 ± 0.09",
        "repetitive": "0.79 ± 0.14",
        "phasic": "0.77 ± 0.17",
        "shift": "0.83 ± 0.14",
        "aborted": "0.67 ± 0.27",
        "r/p rest": null,
        "r/p pose": null
      }
    },
    {
      "name": "focus",
      "module": "I",
      "step": 3,
      "definition": "Locus where the part of the body acts (on). Assessed only for phasic, repetitive and irregular units.",
      "values": ["within body", "on body", "on attached object", "on separate object", "on person", "in space"],
      "polar": true,
      "axis": "body-internal -> body-external. Registers loci of sensory stimulation.",
      "reliability": {
        "within body": "0.62 ± 0.21",
        "on body": "0.83 ± 0.13",
        "on attached object": "0.87 ± 0.23",
        "on separate object": "0.57 ± 0.23",
        "on person": "1.00 (one study)",
        "in space": "0.89 ± 0.08"
      }
    },
    {
      "name": "contact",
      "module": "II",
      "step": 4,
      "definition": "Physical contact between the two hands, for bilateral units.",
      "values": ["act on each other", "act as a unit", "act apart"],
      "restPoseValues": ["r/p crossed", "r/p closed", "r/p open"],
      "specialValues": ["prep-retract"],
      "polar": true,
      "axis": "Bihemispheric sensorimotor activation decreases and expressive freedom increases along act on each other -> act as a unit -> act apart. For rest/pose: body-image stabilisation decreases and psychological openness/rapport increases along crossed -> closed -> open.",
      "reliability": null,
      "reliabilityNote": "see manual Tab. 6 (not transcribed)"
    },
    {
      "name": "formalRelation",
      "module": "II",
      "step": 5,
      "definition": "Symmetry and dominance between the two hands in the complex phase of bilateral phasic/repetitive units.",
      "values": ["symmetrical", "right hand dominance", "left hand dominance", "asymmetrical"],
      "polar": true,
      "axis": "Increasing complexity of neural control. The right-before-left dominance order holds for right-handers and may differ for left-handers.",
      "reliability": {
        "symmetrical": "0.79 ± 0.07",
        "right hand dominance": "0.71 ± 0.08",
        "left hand dominance": "0.70 ± 0.11",
        "asymmetrical": "0.68 ± 0.15"
      }
    },
    {
      "name": "function",
      "module": "III",
      "step": 6,
      "definition": "Groups of body movements sharing movement features associated with emotional, cognitive, physical or practical functions. Assessed only for phasic/repetitive (conceptual) units.",
      "values": [
        "emotion/attitude",
        "emphasis",
        "egocentric deictic",
        "egocentric direction",
        "pantomime",
        "form presentation",
        "spatial relation presentation",
        "motion quality presentation",
        "object-oriented action",
        "subject-oriented action",
        "emblem/social convention"
      ],
      "specialValues": ["different functions"],
      "polar": true,
      "axis": "Development from emotional motions, via gestures, via actions, to conventionalized gestures/actions. Within the seven gesture values (emphasis .. motion quality presentation): from more emotional to more cognitive, with increasing creative complexity and abstraction.",
      "mainGroups": {
        "egocentric gestures": ["egocentric deictic", "egocentric direction", "pantomime"],
        "presentation gestures": ["form presentation", "spatial relation presentation", "motion quality presentation"],
        "actions": ["object-oriented action", "subject-oriented action"]
      },
      "reliability": {
        "emotion/attitude": "0.66 ± 0.21",
        "emphasis": "0.75 ± 0.07",
        "egocentric deictic": "0.56 ± 0.41",
        "egocentric direction": "0.62 ± 0.26",
        "pantomime": "0.74 ± 0.06",
        "form presentation": "0.57 ± 0.16",
        "spatial relation presentation": "0.43 ± 0.29",
        "motion quality presentation": "0.59 ± 0.16",
        "object-oriented action": "0.71 (one study)",
        "subject-oriented action": "0.71 ± 0.14; 0.87 ± 0.00",
        "emblem/social convention": "0.79 ± 0.06"
      }
    },
    {
      "name": "type",
      "module": "III",
      "step": 7,
      "definition": "Typifies gestures within their Function value. Dependent category: the available Type values are determined by the Function value, and the Type label includes its parent Function.",
      "dependentOn": "function",
      "valueCount": 24,
      "polar": false,
      "typesByFunction": {
        "emotion/attitude": ["emotion/attitude-rise", "emotion/attitude-fall", "emotion/attitude-clap/beat", "emotion/attitude-shrug"],
        "emphasis": ["emphasis-baton", "emphasis-back-toss", "emphasis-palm-out", "emphasis-superimposed"],
        "egocentric deictic": ["deictic-external target", "deictic-You", "deictic-self", "deictic-body"],
        "egocentric direction": ["direction-neutral", "direction-imperative", "direction-self-related"],
        "pantomime": ["pantomime-intransitive", "pantomime-transitive-active", "pantomime-transitive-passive"],
        "form presentation": ["form-shape", "form-size"],
        "spatial relation presentation": ["spatial relation-route", "spatial relation-position"],
        "motion quality presentation": ["motion quality-manner", "motion quality-dynamics"],
        "object-oriented action": [],
        "subject-oriented action": [],
        "emblem/social convention": []
      },
      "specialValues": ["other e-motion"],
      "note": "emblem/social convention has no Type values; the manual instead provides a list of specific emblems used in West Germany (ch. 9.4.9). Actions have no Type values either.",
      "reliability": null,
      "reliabilityNote": "see manual Tab. 10 (not transcribed)"
    }
  ],

  "supplementaryCategories": [
    {
      "name": "techniqueOfPresentation",
      "values": ["hand-as-object", "enclosure", "palpating", "tracing"],
      "appliesTo": ["form presentation", "spatial relation presentation", "motion quality presentation", "pantomime"]
    },
    {
      "name": "efforts",
      "values": ["free flow", "bound flow", "light weight", "strong weight", "heavy weight", "sustained time", "sudden time", "indirect space", "direct space"],
      "note": "Laban effort factors."
    },
    {
      "name": "temporalStructure",
      "values": ["single accents", "metrical", "rhythmical"]
    },
    {
      "name": "targetLocation",
      "values": ["right side", "left side", "body-midline", "both sides"]
    },
    {
      "name": "executionHemiSpace",
      "values": ["ipsilateral", "contralateral", "body-midline", "ipsi-contra"]
    },
    {
      "name": "referent",
      "values": ["material", "non-material"],
      "appliesTo": ["egocentric deictic", "egocentric direction", "pantomime", "form presentation", "spatial relation presentation", "motion quality presentation"],
      "status": "work-in-progress in NEUROGES; values are hypothetical and need testing"
    },
    {
      "name": "triggerMotive",
      "values": ["physical regulation", "visual appearance", "mental regulation", "trigger/motive unknown"],
      "appliesTo": ["subject-oriented action"],
      "status": "work-in-progress in NEUROGES; values are hypothetical and need testing"
    }
  ],

  "channels": [
    { "name": "hand-gesture", "bodyPart": "upper-limbs", "inNeurogesScope": true },
    { "name": "head",         "bodyPart": "head",        "inNeurogesScope": true },
    { "name": "posture",      "bodyPart": "trunk",       "inNeurogesScope": true },
    { "name": "face",         "bodyPart": null,          "inNeurogesScope": false,
      "note": "NEUROGES codes upper limbs, lower limbs, head and trunk. Facial expression is a criterion inside value definitions (e.g. emotion/attitude requires an accompanying postural-facial expression) but is not itself a coded body part." },
    { "name": "gaze",         "bodyPart": null,          "inNeurogesScope": false,
      "note": "Gaze is a movement criterion used in Function/Type definitions, not a coded unit." },
    { "name": "stage",        "bodyPart": null,          "inNeurogesScope": false,
      "note": "Scene/environment effects (backdrop, camera). Not nonverbal behavior at all." },
    { "name": "control",      "bodyPart": null,          "inNeurogesScope": false,
      "note": "Plugin/server control commands." },
    { "name": "timing",       "bodyPart": null,          "inNeurogesScope": false,
      "note": "Pure timing, no movement and no target device. Outside NEUROGES — which codes body movement — yet placed relative to speech structure, so still a placement candidate." },
    { "name": "unknown",      "bodyPart": null,          "inNeurogesScope": null,
      "note": "Body involvement not yet determined. Reserved for repertoire assets whose channel can only be settled by video coding (see doc section 3). Distinct from an out-of-scope channel: an `unknown` command may well turn out to be a codable limb movement." }
  ],

  "displayGroupsNote": "The author-facing reduction of the taxonomy: NEUROGES has 11 Function values and 24 Type values, which is too much vocabulary for a non-programmer authoring UI. These groups collapse them for display only — they are VSM-derived, carry no NEUROGES authority, and are recorded here rather than hard-coded in the UI so the reduction stays reviewable (see doc/behavior-taxonomy-neuroges.md 8.4). Array order is display order. Resolution: the first group listing the command's Function wins; failing that, the first group listing its channel. A command matching nothing has no display group and is not shown.",

  "displayGroups": [
    { "id": "background",   "label": "Background",   "siaVisible": true,
      "channels": ["stage"] },
    { "id": "emotion",      "label": "Emotion",      "siaVisible": true,
      "functions": ["emotion/attitude"] },
    { "id": "emphasis",     "label": "Emphasis",     "siaVisible": true,
      "functions": ["emphasis"] },
    { "id": "pointing",     "label": "Pointing",     "siaVisible": true,
      "functions": ["egocentric deictic", "egocentric direction"] },
    { "id": "depiction",    "label": "Depiction",    "siaVisible": true,
      "functions": ["pantomime", "form presentation", "spatial relation presentation", "motion quality presentation"],
      "note": "The whole representational branch. Currently empty for every plugin — this is the gap the Xenia animation request fills." },
    { "id": "convention",   "label": "Convention",   "siaVisible": true,
      "functions": ["emblem/social convention"] },
    { "id": "action",       "label": "Action",       "siaVisible": true,
      "functions": ["object-oriented action", "subject-oriented action"],
      "note": "Visible in the preview panel because these animations are worth previewing, even though they are not co-speech and the placement service will never propose them." },
    { "id": "posture",      "label": "Posture",      "siaVisible": true,
      "channels": ["posture"] },
    { "id": "gaze",         "label": "Gaze",         "siaVisible": true,
      "channels": ["gaze"] },
    { "id": "face",         "label": "Face",         "siaVisible": true,
      "channels": ["face"] },
    { "id": "unclassified", "label": "Unclassified", "siaVisible": true,
      "channels": ["hand-gesture", "head"],
      "note": "Catch-all for in-scope movement channels whose Function is still undetermined. Deliberately visible: an unclassified command should show up as classification debt rather than silently disappear from the UI. Empties itself as the repertoire gets video-coded." }
  ],

  "vsmFields": {
    "cospeech": "Whether the behavior is speech-accompanying and therefore a candidate for utterance-position placement. VSM-derived, not a NEUROGES field.",
    "affiliate": "What the behavior attaches to semantically: referent | rheme | accented-word | clause | whole-utterance | none. VSM-derived; the bridge to the anchor slots of the placement service.",
    "evidence": "video-coded | declared-by-vendor | inferred-from-name. Mandatory. Only video-coded tags are NEUROGES-grade.",
    "confidence": "0..1, the annotator's confidence in this tag given the evidence level."
  },

  "providersNote": "`plugin` is normally a plugin id from plugin-properties.json. `runtime` is a synthetic provider for commands the VSM runtime handles itself, which belong to no plugin and are always available in every project.",

  "commands": [
    { "plugin": "runtime", "command": "pause", "channel": "timing",
      "neuroges": null,
      "vsm": { "cospeech": true, "affiliate": "clause" },
      "evidence": "declared-by-vendor", "confidence": 1.0,
      "note": "Runtime built-in, not a plugin command: pure timing, no visual effect, no target device, never dispatched to an ActivityExecutor (see ActionBlockingUtil). It has no NEUROGES unit because NEUROGES codes body movement. But cospeech is true, per that field's own definition — 'speech-accompanying and therefore a candidate for utterance-position placement' — and a pause is the most structurally regular inline element authors use, typically at a clause boundary. Excluding it would discard the clearest placement signal in the corpus." },

    { "plugin": "charamel-ws", "command": "angry", "channel": "unknown",
      "neuroges": { "function": "emotion/attitude", "type": null },
      "vsm": { "cospeech": true, "affiliate": "rheme" },
      "evidence": "inferred-from-name", "confidence": 0.7,
      "note": "Function is clear; Type (rise/fall/clap-beat/shrug) and limb involvement unverifiable without video. Channel may be face+posture rather than hand-gesture." },
    { "plugin": "charamel-ws", "command": "bored", "channel": "unknown",
      "neuroges": { "function": "emotion/attitude", "type": null },
      "vsm": { "cospeech": true, "affiliate": "rheme" },
      "evidence": "inferred-from-name", "confidence": 0.7, "note": "see angry" },
    { "plugin": "charamel-ws", "command": "crazy", "channel": "unknown",
      "neuroges": { "function": "emotion/attitude", "type": null },
      "vsm": { "cospeech": true, "affiliate": "rheme" },
      "evidence": "inferred-from-name", "confidence": 0.6, "note": "see angry" },
    { "plugin": "charamel-ws", "command": "demanding", "channel": "unknown",
      "neuroges": { "function": "emotion/attitude", "type": null },
      "vsm": { "cospeech": true, "affiliate": "rheme" },
      "evidence": "inferred-from-name", "confidence": 0.6,
      "note": "Attitude rather than emotion. Candidate dominance cue — flag for clinical constraint review." },
    { "plugin": "charamel-ws", "command": "disappointed", "channel": "unknown",
      "neuroges": { "function": "emotion/attitude", "type": null },
      "vsm": { "cospeech": true, "affiliate": "rheme" },
      "evidence": "inferred-from-name", "confidence": 0.7, "note": "see angry" },
    { "plugin": "charamel-ws", "command": "disgust", "channel": "unknown",
      "neuroges": { "function": "emotion/attitude", "type": null },
      "vsm": { "cospeech": true, "affiliate": "rheme" },
      "evidence": "inferred-from-name", "confidence": 0.7, "note": "see angry" },
    { "plugin": "charamel-ws", "command": "happy", "channel": "unknown",
      "neuroges": { "function": "emotion/attitude", "type": null },
      "vsm": { "cospeech": true, "affiliate": "rheme" },
      "evidence": "inferred-from-name", "confidence": 0.7,
      "note": "If limbs are involved, likely emotion/attitude-rise (light weight, overcoming body weight)." },
    { "plugin": "charamel-ws", "command": "pensively", "channel": "unknown",
      "neuroges": { "function": "emotion/attitude", "type": null },
      "vsm": { "cospeech": true, "affiliate": "rheme" },
      "evidence": "inferred-from-name", "confidence": 0.6, "note": "see angry" },
    { "plugin": "charamel-ws", "command": "sad", "channel": "unknown",
      "neuroges": { "function": "emotion/attitude", "type": null },
      "vsm": { "cospeech": true, "affiliate": "rheme" },
      "evidence": "inferred-from-name", "confidence": 0.7,
      "note": "If limbs are involved, likely emotion/attitude-fall (heavy weight, giving in to gravity)." },
    { "plugin": "charamel-ws", "command": "smile", "channel": "face",
      "neuroges": { "function": "emotion/attitude", "type": null },
      "vsm": { "cospeech": true, "affiliate": "rheme" },
      "evidence": "inferred-from-name", "confidence": 0.8, "note": "Facial only in all likelihood." },
    { "plugin": "charamel-ws", "command": "surprised", "channel": "unknown",
      "neuroges": { "function": "emotion/attitude", "type": null },
      "vsm": { "cospeech": true, "affiliate": "rheme" },
      "evidence": "inferred-from-name", "confidence": 0.7, "note": "see angry" },

    { "plugin": "charamel-ws", "command": "emphasis", "channel": "hand-gesture",
      "neuroges": { "structure": "repetitive", "focus": "in space", "function": "emphasis", "type": "emphasis-baton" },
      "vsm": { "cospeech": true, "affiliate": "accented-word" },
      "evidence": "inferred-from-name", "confidence": 0.8,
      "note": "Highest-confidence gesture mapping in the repertoire. NEUROGES emphasis is repetitive in space with an end-point accent, synchronised with mouth and head movements." },
    { "plugin": "charamel-ws", "command": "showpalm", "channel": "hand-gesture",
      "neuroges": { "structure": "repetitive", "focus": "in space", "function": "emphasis", "type": "emphasis-palm-out" },
      "vsm": { "cospeech": true, "affiliate": "accented-word" },
      "evidence": "inferred-from-name", "confidence": 0.7,
      "note": "emphasis-palm-out is defined as small supination-pronation movements with outward accent." },
    { "plugin": "charamel-ws", "command": "showpalmdirection", "channel": "hand-gesture",
      "neuroges": { "focus": "in space", "function": null, "type": null },
      "vsm": { "cospeech": true, "affiliate": "referent" },
      "evidence": "inferred-from-name", "confidence": 0.4,
      "note": "Ambiguous between emphasis-palm-out and egocentric direction (direction-neutral). Needs video." },
    { "plugin": "charamel-ws", "command": "openfists", "channel": "hand-gesture",
      "neuroges": { "focus": "in space", "function": null, "type": null },
      "vsm": { "cospeech": true, "affiliate": "accented-word" },
      "evidence": "inferred-from-name", "confidence": 0.3,
      "note": "Ambiguous between emphasis and emotion/attitude. Needs video." },
    { "plugin": "charamel-ws", "command": "openarm", "channel": "hand-gesture",
      "neuroges": { "focus": "in space", "function": null, "type": null },
      "vsm": { "cospeech": true, "affiliate": "whole-utterance" },
      "evidence": "inferred-from-name", "confidence": 0.3,
      "note": "May be a movement (emotion/attitude-rise) or a rest/pose with r/p open. Openness/rapport-relevant either way." },

    { "plugin": "charamel-ws", "command": "pointopenpalm", "channel": "hand-gesture",
      "neuroges": { "structure": "phasic", "focus": "in space", "function": "egocentric deictic", "type": "deictic-external target" },
      "supplementary": { "referent": null },
      "vsm": { "cospeech": true, "affiliate": "referent" },
      "evidence": "inferred-from-name", "confidence": 0.7 },
    { "plugin": "charamel-ws", "command": "pointovershoulder", "channel": "hand-gesture",
      "neuroges": { "structure": "phasic", "focus": "in space", "function": "egocentric deictic", "type": "deictic-external target" },
      "vsm": { "cospeech": true, "affiliate": "referent" },
      "evidence": "inferred-from-name", "confidence": 0.7 },
    { "plugin": "charamel-ws", "command": "pointdownleft", "channel": "hand-gesture",
      "neuroges": { "structure": "phasic", "focus": "in space", "function": "egocentric deictic", "type": "deictic-external target" },
      "supplementary": { "targetLocation": "left side" },
      "vsm": { "cospeech": true, "affiliate": "referent" },
      "evidence": "inferred-from-name", "confidence": 0.7,
      "note": "Target Location matters here: Lausberg & Kryger (2011) showed that where a referent is placed in gesture space is itself meaningful." },
    { "plugin": "charamel-ws", "command": "pointdownright", "channel": "hand-gesture",
      "neuroges": { "structure": "phasic", "focus": "in space", "function": "egocentric deictic", "type": "deictic-external target" },
      "supplementary": { "targetLocation": "right side" },
      "vsm": { "cospeech": true, "affiliate": "referent" },
      "evidence": "inferred-from-name", "confidence": 0.7, "note": "see pointdownleft" },

    { "plugin": "charamel-ws", "command": "nod", "channel": "head",
      "neuroges": { "structure": "repetitive", "function": "emblem/social convention", "type": null },
      "vsm": { "cospeech": true, "affiliate": "clause" },
      "evidence": "inferred-from-name", "confidence": 0.8,
      "note": "Yes-emblem. Also the canonical listener backchannel — placement in a speaker utterance and in a listening state are different problems." },
    { "plugin": "charamel-ws", "command": "headshake", "channel": "head",
      "neuroges": { "structure": "repetitive", "function": "emblem/social convention", "type": null },
      "vsm": { "cospeech": true, "affiliate": "clause" },
      "evidence": "inferred-from-name", "confidence": 0.8, "note": "No-emblem. Duplicate of `shakehead`." },
    { "plugin": "charamel-ws", "command": "shakehead", "channel": "head",
      "neuroges": { "structure": "repetitive", "function": "emblem/social convention", "type": null },
      "vsm": { "cospeech": true, "affiliate": "clause" },
      "evidence": "inferred-from-name", "confidence": 0.8, "note": "No-emblem. Duplicate of `headshake`." },
    { "plugin": "charamel-ws", "command": "wave", "channel": "hand-gesture",
      "neuroges": { "structure": "repetitive", "focus": "in space", "function": "emblem/social convention", "type": null },
      "vsm": { "cospeech": true, "affiliate": "whole-utterance" },
      "evidence": "inferred-from-name", "confidence": 0.8, "note": "Greeting emblem; conventionally utterance-initial or -final." },
    { "plugin": "charamel-ws", "command": "countleft", "channel": "hand-gesture",
      "neuroges": { "contact": "act on each other", "function": "emblem/social convention", "type": null },
      "vsm": { "cospeech": true, "affiliate": "referent" },
      "evidence": "inferred-from-name", "confidence": 0.6,
      "note": "Counting is the manual's own example of act on each other (digits of one hand touch the fingertips of the other)." },
    { "plugin": "charamel-ws", "command": "introduce", "channel": "hand-gesture",
      "neuroges": { "focus": "in space", "function": null, "type": null },
      "vsm": { "cospeech": true, "affiliate": "referent" },
      "evidence": "inferred-from-name", "confidence": 0.3,
      "note": "Ambiguous between emblem/social convention and egocentric deictic (deictic-You / presenting). Needs video." },
    { "plugin": "charamel-ws", "command": "interogative", "channel": "hand-gesture",
      "neuroges": { "focus": "in space", "function": null, "type": null },
      "vsm": { "cospeech": true, "affiliate": "clause" },
      "evidence": "inferred-from-name", "confidence": 0.3,
      "note": "Spelling as declared by the plugin (sic). Likely emblem or emotion/attitude-shrug. Needs video." },

    { "plugin": "charamel-ws", "command": "armscrossed", "channel": "posture",
      "neuroges": { "activation": "rest/pose", "structure": "r/p pose", "contact": "r/p crossed" },
      "vsm": { "cospeech": false, "affiliate": "none" },
      "evidence": "inferred-from-name", "confidence": 0.7,
