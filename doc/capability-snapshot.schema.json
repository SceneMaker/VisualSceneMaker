{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scenemaker.dfki.de/schema/sceneflow-ir/v1/capability-snapshot.schema.json",
  "title": "SceneFlow Capability Snapshot v1.2",
  "description": "Runtime/project capability context used to constrain LLM IR generation and semantic validation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "snapshotVersion",
    "generatedAt",
    "project",
    "flow"
  ],
  "properties": {
    "snapshotVersion": {
      "type": "string",
      "const": "1.2"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "string",
      "description": "Where this snapshot was derived from."
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "androidProject": {
          "type": "boolean"
        },
        "plugins": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/plugin"
          },
          "default": []
        },
        "agents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/agent"
          },
          "default": []
        }
      }
    },
    "script": {
      "type": "object",
      "additionalProperties": false,
      "description": "SceneScript content inventory. Scenes are content rather than graph structure, so they sit beside \"flow\" rather than inside it.",
      "properties": {
        "scenes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "description": "Scene group name. This is the value PlayScene takes; language variants of one name form one group."
              },
              "languages": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Two-letter codes of the language variants that exist for this scene group."
              },
              "speakers": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Turn speakers. Each must match a project agent name for the scene to play."
              },
              "turnCount": {
                "type": "integer",
                "minimum": 0
              },
              "wordCount": {
                "type": "integer",
                "minimum": 0,
                "description": "Spoken words. Zero means the scene carries only commands or parameters."
              },
              "parameters": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Scene parameter names. A scene with parameters needs arguments passed to PlayScene."
              },
              "referencedAgents": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Agents addressed by inline commands other than the turn speaker."
              },
              "inlineCommands": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Names of inline commands used inside the scene. Each must be provided by a plugin."
              }
            }
          }
        },
        "sections": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Section headings used to structure the script document. Not spoken."
        }
      }
    },
    "screens": {
      "type": "object",
      "additionalProperties": false,
      "description": "Screens defined in screens.json beside the project, with the variables each is wired to. Absent screens.json yields an empty list rather than an error.",
      "properties": {
        "screens": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "readsVariables": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Variables the screen displays, via bindVar, dataVar or srcVar. These have to hold a value before the screen is shown."
              },
              "writesVariables": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Variables the screen sets, via sendsVar. A control such as a button or slider hands the value back to the flow."
              }
            }
          }
        },
        "characterSrcVariable": {
          "type": "string",
          "description": "Variable supplying the character frame source, a project-level binding rather than one belonging to a single screen."
        }
      }
    },
    "flow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rootId",
        "startNodeIds",
        "variables",
        "allowedEdgeTypes",
        "nodes",
        "edges"
      ],
      "properties": {
        "rootId": {
          "type": "string",
          "minLength": 1
        },
        "startNodeIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "default": []
        },
        "variables": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/variable"
          },
          "default": []
        },
        "allowedEdgeTypes": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "EEDGE",
              "CEDGE",
              "PEDGE",
              "TEDGE",
              "FEDGE",
              "IEDGE"
            ]
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          },
          "default": []
        },
        "edges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/edge"
          },
          "default": []
        }
      }
    }
  },
  "$defs": {
    "feature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "value"
      ],
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "string"
        }
      }
    },
    "plugin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "className",
        "type",
        "load"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "className": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "load": {
          "type": "boolean"
        },
        "commands": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "type": {
                "type": "string"
              },
              "summary": {
                "type": "string",
                "description": "One line. Full prose and examples stay in plugin-properties.json."
              },
              "params": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "name"
                  ],
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "type": {
                      "type": "string",
                      "description": "Declared parameter type, e.g. string, int, boolean."
                    },
                    "required": {
                      "type": "boolean"
                    },
                    "enum": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "description": "Allowed values, when the parameter is constrained to a set."
                    }
                  }
                }
              }
            }
          },
          "description": "Commands this plugin declares. An agent reaches them through agent.device -> plugin.name -> plugin.commands."
        },
        "writesVariables": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "type": {
                "type": "string"
              }
            }
          },
          "description": "SceneFlow variables the plugin sets at runtime."
        },
        "readsVariables": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "type": {
                "type": "string"
              }
            }
          },
          "description": "SceneFlow variables the plugin expects to be set."
        }
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "device"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "device": {
          "type": "string",
          "minLength": 1
        },
        "features": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/feature"
          },
          "default": []
        }
      }
    },
    "variable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "type",
        "scope"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "pattern": "^(Int|Bool|Float|String|Event)(\\s*\\(.*\\))?$",
          "description": "Base type Int, Bool, Float, String or Event, optionally parameterised. Event variables carry a parameter list in the model, for example \"Event(*, 10)\", so the base name alone does not match."
        },
        "scope": {
          "type": "string",
          "enum": [
            "global",
            "local"
          ]
        },
        "ownerNodeId": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "parentSuperNodeId",
        "isSuperNode",
        "isHistoryNode"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string"
        },
        "parentSuperNodeId": {
          "type": "string",
          "minLength": 1
        },
        "isSuperNode": {
          "type": "boolean"
        },
        "isHistoryNode": {
          "type": "boolean"
        },
        "startNodeIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "default": []
        },
        "commandCount": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "sourceNodeId",
        "targetNodeId"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "EEDGE",
            "CEDGE",
            "PEDGE",
            "TEDGE",
            "FEDGE",
            "IEDGE"
          ]
        },
        "sourceNodeId": {
          "type": "string",
          "minLength": 1
        },
        "targetNodeId": {
          "type": "string",
          "minLength": 1
        },
        "conditionText": {
          "type": "string"
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 0
        },
        "probability": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        }
      }
    }
  }
}
