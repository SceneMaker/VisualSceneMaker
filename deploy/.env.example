# Copy this file to ".env" in this same directory and fill in real values before
# running `docker compose up -d --build`. Do not commit the real ".env" to git.

# Fixed auth token for the runtime API/Web UI. Generate one, e.g.:
#   openssl rand -hex 24
VSM_TOKEN=changeme-generate-a-real-secret

# Absolute path on the HOST machine to the project directory to load
# (e.g. the "Confidence - SIA Layer" project folder — must contain project.xml,
# sceneflow.xml, character-config.json, screens.json, etc.).
VSM_PROJECT_DIR=/srv/vsm-projects/confidence-sia-layer
