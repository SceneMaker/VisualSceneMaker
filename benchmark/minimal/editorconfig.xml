<entry key="scriptfonsize">16</entry>
<entry key="workspace_fontsize">14</entry>
<entry key="visualizationtrace">true</entry>
<entry key="defaultsupernodename">default</entry>
<entry key="grid">true</entry>
<entry key="autohidebottombar">true</entry>
<entry key="grid_y">1</entry>
</properties>
