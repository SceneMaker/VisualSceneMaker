    "plugin": {
        "id": "user-cue-service",
        "name": "User Cue Service",
        "className": "de.dfki.vsm.xtension.service.UserCueService",
        "androidCompatible": true,
        "description": "General service for storing timecoded interaction based cues",
        "tags": [
            "user cues",
            "interaction",
            "timecode",
            "diary"
        ]
    },
    "categories": {
        "primary": "processing",
        "secondary": [
            
        ]
    },
    "agents": [
        {
            "name": "User Profile Management",
            "description": "Create, load, and persist user profiles with configurable attributes"
        },
        {
            "name": "Diary Management",
            "description": "Timecoded diary entries with context annotations and day-based retrieval"
        },
        {
            "name": "Emotion Tracking",
            "description": "5-point emotion scale with 7-day aggregation and per-day averages"
        },
        {
            "name": "LIWC Analysis",
            "description": "Psycholinguistic feature capture across 20 categories (affect, pronouns, cognition, etc.)"
        },
        {
            "name": "Interaction Logging",
            "description": "Utterance timing, avatar animations, and general interaction log entries"
        }
    ],
