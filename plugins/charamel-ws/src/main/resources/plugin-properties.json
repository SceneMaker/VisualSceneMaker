{
    "schemaVersion": "1.0",
    "specVersion": "1.1",
    "specHash": "3cdf951bb39f5a4a",
    "plugin": {
        "id": "charamel-ws",
        "name": "Charamel WebSocket",
        "className": "de.dfki.vsm.xtension.charamelWs.charamelWsExecutor",
        "androidCompatible": false,
        "description": "Interactive web-based virtual character",
        "tags": [
            "SIA",
            "web",
            "avatar",
            "virtual character"
        ]
    },
    "categories": {
        "primary": "output",
        "secondary": [
            
        ]
    },
    "config": {
        "required": [
            {
                "name": "ws_port",
                "type": "int",
                "default": 3030,
                "description": "WebSocket port"
            },
            {
                "name": "wss_port",
                "type": "int",
                "default": 3031,
                "description": "Secure WebSocket port"
            },
            {
                "name": "sceneflowVar",
                "type": "string",
                "sceneflowtype": "Bool",
                "default": "avatar_connected",
                "description": "Connection state variable"
            },
            {
                "name": "characterSpeaking",
                "type": "string",
                "sceneflowtype": "Bool",
                "default": "avatar_speaking",
                "description": "Character speaking state variable"
            },
            {
                "name": "sceneflowTurnUtteranceVar",
                "type": "string",
                "sceneflowtype": "String",
                "default": "turn_utterance",
                "description": "Current utterance variable"
            }
        ],
        "optional": [
            {
                "name": "certificate",
                "type": "filepath",
                "description": "Path to SSL certificate"
            },
            {
                "name": "character_url",
                "type": "string",
                "default": "https://vuppetmaster.de/dev/ubidenz/",
                "description": "Base URL of the character player page. Combined with ws_port by htmlgui-ws to auto-configure the character iframe."
            }
        ],
        "agent": {
            "fixed": [
                {
                    "name": "voice",
                    "type": "string",
                    "required": true,
                    "description": "TTS voice name (e.g., 'Marlene')"
                }
            ],
            "dynamic": {
                "enabled": false
            }
        }
    },
