{
    "schemaVersion": "1.0",
    "specVersion": "1.1",
    "specHash": "88f4791ae908dc16",
    "plugin": {
        "id": "heartflow",
        "name": "Heart Flow",
        "className": "de.dfki.vsm.xtension.heartflow.HeartFlowExecutor",
        "androidCompatible": false,
        "description": "Real-time ECG/HRV biosignal plugin for the Polar H10. Streams heart rate, HRV metrics (RMSSD, SDNN, pNN50, SD1/SD2), motion class, breathing phase/rate, and a predictive heartbeat event pre-scheduled to fire at the moment of the user's next cardiac contraction.",
        "tags": [
            "ecg",
            "hrv",
            "heartbeat",
            "biosignal",
            "polar",
            "h10",
            "accelerometer",
            "breathing",
            "motion"
        ]
    },
    "categories": {
        "primary": "input",
        "secondary": [
            "processing"
        ]
    },
    "config": {
        "required": [
            {
                "name": "hf_bpm",
                "type": "string",
                "sceneflowtype": "Float",
                "default": "hf_bpm",
                "description": "SceneFlow variable for heart rate (Float, bpm)"
            },
            {
                "name": "hf_rmssd",
                "type": "string",
                "sceneflowtype": "Float",
                "default": "hf_rmssd",
                "description": "SceneFlow variable for RMSSD (Float, ms)"
            },
            {
                "name": "hf_sdnn",
                "type": "string",
                "sceneflowtype": "Float",
                "default": "hf_sdnn",
                "description": "SceneFlow variable for SDNN (Float, ms)"
            },
            {
                "name": "hf_pnn50",
                "type": "string",
                "sceneflowtype": "Float",
                "default": "hf_pnn50",
                "description": "SceneFlow variable for pNN50 (Float, %)"
            },
            {
                "name": "hf_sd1",
                "type": "string",
                "sceneflowtype": "Float",
                "default": "hf_sd1",
                "description": "SceneFlow variable for SD1 (Float, ms)"
            },
            {
                "name": "hf_sd2",
                "type": "string",
                "sceneflowtype": "Float",
                "default": "hf_sd2",
                "description": "SceneFlow variable for SD2 (Float, ms)"
            },
            {
                "name": "hf_median_rr",
                "type": "string",
                "sceneflowtype": "Float",
                "default": "hf_median_rr",
                "description": "SceneFlow variable for median RR (Float, ms)"
            },
            {
                "name": "hf_motion",
                "type": "string",
                "sceneflowtype": "String",
                "default": "hf_motion",
                "description": "SceneFlow variable for motion category (String: Still/Slight/Strong)"
            },
            {
                "name": "hf_motion_score",
                "type": "string",
                "sceneflowtype": "Float",
                "default": "hf_motion_score",
                "description": "SceneFlow variable for normalised motion score (Float, 0\u20131)"
            },
            {
                "name": "hf_breathing_phase",
                "type": "string",
                "sceneflowtype": "String",
                "default": "hf_breathing_phase",
                "description": "SceneFlow variable for breathing phase (String: inhale/exhale)"
            },
            {
                "name": "hf_breathing_rate",
                "type": "string",
                "sceneflowtype": "Float",
                "default": "hf_breathing_rate",
                "description": "SceneFlow variable for breathing rate (Float, breaths/min)"
            },
            {
                "name": "hf_heartbeat",
                "type": "string",
                "sceneflowtype": "Event(String)",
                "default": "hf_heartbeat",
                "description": "SceneFlow variable for predictive heartbeat event (Event(String), value: beat)"
            },
            {
                "name": "hf_battery",
                "type": "string",
                "sceneflowtype": "Float",
                "default": "hf_battery",
                "description": "SceneFlow variable for battery level (Float, %)"
            },
            {
                "name": "hf_connected",
                "type": "string",
                "sceneflowtype": "Bool",
                "default": "hf_connected",
                "description": "SceneFlow variable for connection state (Bool)"
            }
        ],
        "optional": [
            {
                "name": "ws_url",
                "type": "string",
                "default": "ws://localhost:7878",
                "description": "WebSocket URL of the Heart Flow server"
            },
            {
                "name": "auto_connect",
                "type": "string",
                "default": "false",
                "description": "If true, send auto_connect on launch \u2014 Heart Flow scans and connects to the first Polar H10 found automatically, without browser interaction"
            },
            {
                "name": "reconnect_delay_ms",
                "type": "string",
                "default": "2000",
                "description": "Reconnect delay in ms after connection loss"
            },
            {
                "name": "beat_offset_ms",
                "type": "string",
                "default": "0",
                "description": "Offset added to predicted beat epoch (ms). Use 0 to fire at the R-peak, +100 to fire at mechanical contraction onset, or negative to compensate for animation render lag."
            },
            {
                "name": "min_confidence",
                "type": "string",
                "default": "0.3",
                "description": "Minimum heartbeat prediction confidence [0\u20131]. Events below this are suppressed (arrhythmia / irregular rhythm guard)."
            }
        ]
    },
    "variables": {
        "writes": [
            {
                "var": "hf_bpm",
                "type": "Float",
                "description": "Heart rate in BPM (from device HR notification)"
            },
            {
                "var": "hf_rmssd",
                "type": "Float",
                "description": "RMSSD in ms (artifact-rejected, updated per beat)"
            },
            {
                "var": "hf_sdnn",
                "type": "Float",
                "description": "SDNN in ms"
            },
            {
                "var": "hf_pnn50",
                "type": "Float",
                "description": "pNN50 in %"
            },
            {
                "var": "hf_sd1",
                "type": "Float",
                "description": "Poincar\u00e9 SD1 in ms (short-term / vagal)"
            },
            {
                "var": "hf_sd2",
                "type": "Float",
                "description": "Poincar\u00e9 SD2 in ms (overall variability)"
            },
            {
                "var": "hf_median_rr",
                "type": "Float",
                "description": "Median of last 8 RR intervals in ms"
            },
            {
                "var": "hf_motion",
                "type": "String",
                "description": "Still / Slight / Strong \u2014 updated at 25 Hz"
            },
            {
                "var": "hf_motion_score",
                "type": "Float",
                "description": "Normalised motion RMS score 0\u20131"
            },
            {
                "var": "hf_breathing_phase",
                "type": "String",
                "description": "inhale or exhale \u2014 updated at each zero-crossing"
            },
            {
                "var": "hf_breathing_rate",
                "type": "Float",
                "description": "Breathing rate in breaths/min (0 until first estimate)"
            },
            {
                "var": "hf_heartbeat",
                "type": "Event(String)",
                "description": "Pre-emptive heartbeat event. Value: beat. Fires at the predicted R-peak time using absolute epoch scheduling."
            },
            {
                "var": "hf_battery",
                "type": "Float",
                "description": "Polar H10 battery level in %"
            },
            {
                "var": "hf_connected",
                "type": "Bool",
                "description": "True while Heart Flow is streaming ECG data"
            }
        ]
    }
}
