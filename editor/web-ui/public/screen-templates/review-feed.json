{
  "version": 1,
  "screens": {
    "session-review": {
      "background": "#ffffff",
      "layout": "flex-column",
      "alignItems": "stretch",
      "elements": [
        {
          "type": "vsm-panel",
          "layout": "flex-row",
          "background": "#eef2ff",
          "padding": "10px 16px",
          "alignItems": "center",
          "children": [
            {
              "type": "sl-text",
              "content": "Session Review",
              "style": { "font-weight": "700", "font-size": "1rem", "color": "#2c4282" }
            },
            { "type": "vsm-filler", "flexGrow": true },
            {
              "type": "sl-text",
              "content": "Grey entries = LLM annotations",
              "style": { "font-size": "0.78rem", "color": "#6b7280" }
            }
          ]
        },
        {
          "type": "vsm-feed",
          "dataVar": "conversation_log",
          "agentColor": "#e8f4fd",
          "userColor": "#eafbe8",
          "systemColor": "#f0f0f0",
          "agentLabel": "Agent",
          "userLabel": "You",
          "showTimestamps": true,
          "height": "450px",
          "style": { "flex": "1", "padding": "8px" }
        }
      ]
    }
  }
}
