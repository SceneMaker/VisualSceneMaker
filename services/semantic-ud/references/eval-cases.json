  {
    "id": "de-clause-01-multi-object",
    "language": "de",
    "text": "Ich gebe dem Kind den roten Ball.",
    "why": "Phase 1.2: the dative indirect object is obl:arg, not iobj, and used to be dropped entirely because select_object returned the first match. Phrase spans must give 'den roten Ball', not the head token 'Ball'.",
    "expected": {
      "subject": "Ich",
      "verb": "gebe",
      "object": "Ball"
    },
    "expectedClauses": [
      {
        "type": "main",
        "verb": "gebe",
        "subject": "Ich",
        "objects": [
          {
            "kind": "indirect",
            "phrase": "dem Kind"
          },
          {
            "kind": "direct",
            "phrase": "den roten Ball"
          }
        ]
      }
    ],
    "expectedAnchorSlots": [
      "utterance-initial",
      "before-object",
      "after-object",
      "before-final-punct",
      "utterance-final"
    ]
  },
  {
    "id": "de-clause-02-ccomp",
    "language": "de",
    "text": "Lass mich einen Vorschlag machen wie wir zusammen den Nachmittag gestalten.",
    "why": "Phase 1.1: the ccomp's subject 'wir' used to be reported against the main clause's verb 'machen'. Roles must resolve per clause.",
    "expected": {
      "subject": "wir",
      "verb": "machen",
      "object": "mich"
    },
    "expectedClauses": [
      {
        "type": "main",
        "verb": "machen",
        "subject": "",
        "objects": [
          {
            "kind": "direct",
            "phrase": "mich"
          },
          {
            "kind": "direct",
            "phrase": "einen Vorschlag"
          }
        ]
      },
      {
        "type": "subordinate",
        "verb": "gestalten",
        "subject": "wir",
        "objects": [
          {
            "kind": "direct",
            "phrase": "den Nachmittag"
          }
        ]
      }
    ],
    "expectedAnchorSlots": [
      "utterance-initial",
      "clause-initial",
      "before-subject",
      "after-verb"
    ]
  },
  {
