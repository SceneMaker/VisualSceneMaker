  {
    "id": "de-clause-05-csubj-predicative",
    "language": "de",
    "text": "Schön dass Du da bist.",
    "why": "csubj had to be treated as clause-introducing: 'bist' is the clausal SUBJECT of 'Schön'. Without it 'Du'/'bist' leaked into the main clause and 'Schön' got no role, so no anchor slot existed where an author had in fact placed a command. The verbless predicative clause root is reported as predicate.",
    "expectedClauses": [
      {
        "type": "main",
        "verb": "",
        "predicate": "Schön"
      },
      {
        "type": "subordinate",
        "verb": "bist",
        "subject": "Du"
      }
    ],
    "expectedAnchorSlots": [
      "utterance-initial",
      "after-predicate",
      "clause-initial"
    ]
  },
  {
    "id": "de-weak-01-informal-greeting",
    "language": "de",
    "text": "Hallo ich bin Xenia.",
    "knownWeak": true,
    "why": "Informal greeting. The default model tags 'Hallo' as the root VERB with 'bin' as its ccomp, inventing a second clause; combined_german-nlp-electra parses it correctly. This case asserts the CORRECT reading, so fixing it shows up as progress instead of as a regression against a pinned mistake.",
    "expected": {
      "subject": "ich",
      "verb": "bin",
      "object": ""
    },
    "expectedClauses": [
      {
        "type": "main",
        "verb": "bin",
        "subject": "ich",
        "objects": []
      }
    ]
  },
  {
    "id": "de-weak-02-imperative-root",
    "language": "de",
    "text": "Schau mal, wie Bob das findet.",
    "knownWeak": true,
    "why": "German imperative. Both the default and the transformer make the adverb 'mal' the sentence root, leaving the main clause verbless; the correct reading is an imperative main clause with verb 'Schau'. Asserts the CORRECT reading.",
    "expectedClauses": [
      {
        "type": "main",
        "verb": "schau",
        "subject": ""
      },
      {
        "type": "subordinate",
        "verb": "findet",
        "subject": "Bob",
        "objects": [
          {
            "kind": "direct",
            "phrase": "das"
          }
        ]
      }
    ],
    "expected": {
      "subject": "",
      "verb": "Schau",
      "object": ""
    }
  },
  {
    "id": "de-address-01-greeting-comma",
    "language": "de",
    "text": "Hey, Ich habe eine Aufgabe für Dich.",
    "why": "Regression test for a fixed bug of OURS, not the parser's: select_address's trailing-vocative fallback (written for '..., du Bloedmann!') fired on a leading greeting comma and reported the following subject as the addressee, so 'Ich' was both subject and address. With a greeting comma the addressee sits BEFORE it; a greeting with no name after it has no addressee, and reporting none beats reporting the wrong one.",
    "expected": {
      "subject": "Ich",
      "verb": "habe",
      "object": "Aufgabe"
    },
    "expectedClauses": [
      {
        "type": "main",
        "verb": "habe",
        "subject": "Ich",
        "objects": [
          {
            "kind": "direct",
            "phrase": "eine Aufgabe für Dich"
          }
        ]
      }
    ],
    "expectedNoAddress": true
  }
]
